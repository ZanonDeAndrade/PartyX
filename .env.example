# Copie para `.env` e preencha. O arquivo `.env` nunca vai para o Git.
# Em homologação e produção, os segredos vêm do Secret Manager, não de arquivo.

NODE_ENV=development
# local | homologacao | producao
APP_ENV=local
PORT=8080

# Neon: conexão pooled para a aplicação, conexão direta para migrações.
# Sem banco, a API sobe e o health check informa "não configurado".
DATABASE_URL=
DATABASE_URL_DIRECT=
# Teste local sem Neon: npm run db:test:up
#   postgres://partyx:partyx_test_only@127.0.0.1:55432/postgres
DB_POOL_MAX=5

# Pasta do build do front-end servida pela API
WEB_DIST_DIR=dist

# Autenticação
# Segredo do token CSRF (32+ caracteres). Obrigatório fora do ambiente local; vem do Secret Manager.
SESSION_SECRET=
# Versões em vigor dos textos legais. Em produção, sem as duas o cadastro fica bloqueado.
# Fora de produção, se vazias, valem versões fictícias ("ficticio-0").
TERMS_VERSION=
PRIVACY_VERSION=
# Versão da Política de Cancelamento e pasta com os textos fornecidos pela PartyX (termos-de-uso.txt, privacidade.txt,
# cancelamento.txt, meia-entrada.txt). Fora do Git. Em produção, sem eles a venda fica bloqueada (docs/visual-e-legal.md).
CANCELLATION_VERSION=
LEGAL_CONTENT_DIR=
# "true" só depois da aprovação escrita da proposta visual pelo cliente (CA-33). Sem isso o tema segue provisório.
VISUAL_APPROVED=false
# Retenção dos dados técnicos, em dias. SEM padrão: vazio = não apaga (decisão da PartyX, docs/lgpd.md).
RETENTION_LOGIN_ATTEMPTS_DAYS=
RETENTION_SESSIONS_DAYS=
RETENTION_PASSWORD_RESETS_DAYS=
# Endereço público: links dos e-mails e origem aceita em requisições que alteram dados
PUBLIC_BASE_URL=http://localhost:5173
# Protótipo e /docs* somente em homologação. O build também precisa de APP_ENV=homologacao e ENABLE_PROTOTYPE=true.
ENABLE_PROTOTYPE=false
# Proxies confiáveis na frente da API (Cloud Run direto: 1). 0 desliga a leitura do IP.
TRUSTED_PROXY_HOPS=0
# Tetos de cadastro: filtro rápido por IP e disjuntor global persistido no banco.
SIGNUPS_PER_IP_PER_HOUR=100
GLOBAL_SIGNUPS_PER_HOUR=1000
GLOBAL_RECOVERIES_PER_HOUR=60
# Teto agregado entre instâncias de portaria, por minuto.
GATE_SCANS_PER_MINUTE=3000
GATE_SEARCHES_PER_MINUTE=400

# Banners dos eventos (Cloud Storage). Sem BANNER_BUCKET, só o ambiente local grava em .data/banners.
BANNER_BUCKET=
BANNER_PUBLIC_BASE_URL=

# Compra. D-03 decidida em 11/10/2026: reserva de 30 minutos (mínimo do Pix no Mercado Pago). D-05 segue premissa.
RESERVATION_MINUTES=30
MAX_TICKETS_PER_ORDER=6
# Em produção as vendas ficam fechadas até SALES_OPEN=true (decisão expressa, depois do aceite). Nos demais ambientes abrem sozinhas.
SALES_OPEN=

# Gateway de pagamento: `mercadopago` (D-01) ou `mock` (fictício, só com APP_ENV=local).
# Vazio: mock no ambiente local e nenhum nos demais. Em homologação e produção, `mock` impede o servidor de subir.
PAYMENT_GATEWAY=
# sandbox | producao. Produção só aceita `producao`; o ambiente local recusa `producao` (cobrança real).
GATEWAY_ENVIRONMENT=
# Mercado Pago (docs/pagamento-mercadopago.md). NUNCA preencha aqui: os valores de teste vão no .env.local pelo script
# `bash scripts/setup-mp-credentials.sh`; os de produção vão no Secret Manager por `scripts/setup-mp-credentials-producao.sh`.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
# Id da conta que recebe (não é segredo); toda order precisa ter este recebedor para ser aprovada.
MP_COLLECTOR_ID=

# Rotinas internas (reconsulta de pagamentos), chamadas pelo Cloud Scheduler com token OIDC. Sem as duas, respondem 503.
JOBS_AUDIENCE=
JOBS_CALLER_EMAIL=

# Chaves do HMAC dos QR Codes dos ingressos: "versão:chave" (base64url, 32+ bytes), separados por vírgula. Obrigatória fora do local.
# Gerar uma: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotação: ACRESCENTE a versão nova e troque QR_HMAC_CURRENT. Nunca remova uma versão enquanto houver ingresso emitido com ela.
QR_HMAC_KEYS=
QR_HMAC_CURRENT=

# E-mail transacional (D-09: provedor, domínio e remetente a definir pelo cliente). SMTP é aceito por todos os provedores comuns.
# Sem SMTP_URL: o ambiente local grava os e-mails em .data/emails (captura fictícia); os demais ficam sem envio e a fila alerta.
SMTP_URL=
EMAIL_FROM=
EMAIL_REPLY_TO=
