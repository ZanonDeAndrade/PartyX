{
  "name": "partyx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild index=server/src/index.ts migrate=server/scripts/migrate.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outdir=dist-server",
    "start": "node dist-server/index.js",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\"",
    "test": "vitest run && vitest run -c vitest.cluster.config.ts",
    "test:watch": "vitest",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env server/scripts/migrate.ts",
    "db:rollback": "tsx --env-file-if-exists=.env server/scripts/rollback.ts",
    "admin:bootstrap": "tsx --env-file-if-exists=.env server/scripts/bootstrap-admin.ts",
    "jobs:expire": "tsx --env-file-if-exists=.env server/scripts/expire-reservations.ts",
    "tickets:backfill": "tsx --env-file-if-exists=.env server/scripts/backfill-tickets.ts",
    "db:check": "tsx --env-file-if-exists=.env server/scripts/db-check.ts",
    "db:test:up": "if [ -f ./.env.test ]; then set -a; . ./.env.test; set +a; fi; docker compose -p partyx-test -f docker-compose.test.yml up -d --wait",
    "db:test:down": "if [ -f ./.env.test ]; then set -a; . ./.env.test; set +a; fi; docker compose -p partyx-test -f docker-compose.test.yml down",
    "test:db": "if [ -z \"$TEST_DATABASE_URL\" ]; then set -a; . ./.env.test; set +a; fi; npm test",
    "ops:fee": "tsx --env-file-if-exists=.env server/scripts/ops-fee-statement.ts",
    "ops:weekly": "tsx --env-file-if-exists=.env server/scripts/ops-weekly.ts",
    "ops:export-closure": "tsx --env-file-if-exists=.env server/scripts/ops-export-closure.ts",
    "check:migrations": "if [ -f ./.env.test ] && [ -z \"$TEST_DATABASE_URL\" ]; then set -a; . ./.env.test; set +a; fi; tsx server/scripts/check-migrations.ts",
    "db:create-app-role": "tsx --env-file-if-exists=.env server/scripts/create-app-role.ts",
    "backup:verify": "tsx server/scripts/verify-restore.ts",
    "db:env": "tsx server/scripts/db-environment.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "@hono/node-server": "^2.1.3",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "google-auth-library": "^9.15.1",
    "hono": "^4.13.12",
    "jsqr": "^1.4.0",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "mailparser": "^3.9.33",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "smtp-server": "^3.19.16",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
